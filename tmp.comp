float nan() { uint bits = 0xffffffffu; return uintBitsToFloat(bits); }
layout(push_constant) uniform push_consts { 	ADDR_T data0_65536; 	ADDR_T data1_65536; } push;
void main()
{
  int gidx0 = int(gl_WorkGroupID.x); /* 4 */
  int gidx1 = int(gl_WorkGroupID.y); /* 32 */
  int lidx0 = int(gl_LocalInvocationID.x); /* 8 */
  int lidx1 = int(gl_LocalInvocationID.y); /* 16 */
  int alu0 = (lidx0+(gidx1<<(3))+(gidx0<<(14))+(lidx1<<(10)));
  float val0 = float_ptr(push.data1_65536 + alu0*4).data[0];
  float val1 = float_ptr(push.data1_65536 + (alu0+(256))*4).data[0];
  float val2 = float_ptr(push.data1_65536 + (alu0+(512))*4).data[0];
  float val3 = float_ptr(push.data1_65536 + (alu0+(768))*4).data[0];
  vec4_ptr(push.data0_65536 + (((gidx0<<(6))+(lidx1<<(2))+(gidx1<<(11))+(lidx0<<(8)))*4)).data[0] = vec4(val0,val1,val2,val3);
