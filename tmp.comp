		vec4 a4 = vec4(a.data[i], a.data[i+1], a.data[i+2], a.data[i+3]);
		vec4 b4 = vec4(b.data[i], b.data[i+1], b.data[i+2], b.data[i+3]);
		d += dot(a4, b4);
	}
	return d;
}

vec16 add(vec16 a, vec16 b)
{
